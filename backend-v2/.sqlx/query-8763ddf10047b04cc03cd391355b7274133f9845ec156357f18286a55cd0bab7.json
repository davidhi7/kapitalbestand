{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                s.id, s.name, s.user_id, s.created_at, s.updated_at,\n                (SELECT COUNT(*) FROM oneoff_transactions o WHERE o.shop_id = s.id) AS \"oneoff!\",\n                (SELECT COUNT(*) FROM recurring_transactions r WHERE r.shop_id = s.id) AS \"recurring!\"\n            FROM shops s\n            WHERE s.user_id = $1\n            LIMIT $2 OFFSET $3\n            ",
